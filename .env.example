# ==============================================================================
# WEBSITE SEKOLAH - TEMPLATE KONFIGURASI ENVIRONMENT (.env.example)
# Salin file ini menjadi '.env' dan sesuaikan nilainya dengan konfigurasi server.
# JANGAN PERNAH MENYIMPAN KATA SANDI ASLI DI FILE CONTOH INI!
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000

# CORS: daftar origin frontend dipisahkan koma, tanpa garis miring di akhir.
# Development default: localhost:5173 dan 127.0.0.1:5173.
# Production: WAJIB isi domain frontend sebenarnya, mis. https://sekolah.example.id.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keamanan Autentikasi Admin (JWT) - Gunakan string acak minimal 32 karakter untuk produksi
JWT_SECRET=
# Token rahasia 32+ karakter untuk setup admin pertama melalui halaman login.
# Buat dengan: openssl rand -hex 32. Hapus/nonaktifkan setelah setup selesai.
ADMIN_SETUP_TOKEN=
JWT_EXPIRES_IN=8h

# Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=school_user
DB_PASSWORD=kata_sandi_mysql_anda
DB_NAME=school_website_demo
DB_CONNECTION_LIMIT=10

# Media Upload Directory
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Frontend Base URL (Client-side)
VITE_API_URL=/api
VITE_SCHOOL_NAME="Nama Sekolah Anda"
