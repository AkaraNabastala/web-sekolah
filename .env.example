# ==============================================================================
# SMP ISLAM CARUY - TEMPLATE KONFIGURASI ENVIRONMENT (.env.example)
# Salin file ini menjadi '.env' dan sesuaikan nilainya dengan konfigurasi server.
# JANGAN PERNAH MENYIMPAN KATA SANDI ASLI DI FILE CONTOH INI!
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000

# Keamanan Autentikasi Admin (JWT) - Gunakan string acak minimal 32 karakter untuk produksi
JWT_SECRET=ganti_dengan_jwt_secret_rahasia_dan_kuat_di_server_anda
JWT_EXPIRES_IN=7d

# Fallback JSON hanya untuk development offline; tidak digunakan saat MySQL aktif.
ALLOW_JSON_FALLBACK=true

# Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smp_user
DB_PASSWORD=kata_sandi_mysql_anda
DB_NAME=web-sekolah
DB_CONNECTION_LIMIT=10

# Media Upload Directory
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Frontend Base URL (Client-side)
VITE_API_URL=/api
VITE_SCHOOL_NAME="SMP Islam Caruy"
